# Copy to .env and fill in production values.
# Never commit a filled .env file.

DB_HOST=localhost
DB_NAME=click_to_chat_manager
DB_USER=root
DB_PASS=
SYSTEM_BASE_URL=https://ctc.example.com
APP_TIMEZONE=Asia/Kuala_Lumpur

# API key authentication pepper (HMAC). Generate with:
# php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
API_KEY_PEPPER=

# API key encryption key (base64-encoded 32 bytes). Generate with:
# php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
API_KEY_ENCRYPTION_KEY=
